-- See https://wiki.hypr.land/Configuring/Basics/Monitors/
-- List current monitors and supported resolutions with: hyprctl monitors all

local omarchy_gdk_scale = 1
local omarchy_monitor_scale = 1.25

hl.env("GDK_SCALE", tostring(omarchy_gdk_scale))
hl.monitor({ output = "", mode = "preferred", position = "auto", scale = omarchy_monitor_scale })

-- Configure a specific monitor.
-- hl.monitor({ output = "DP-2", mode = "2560x1440@144", position = "0x0", scale = 1 })

-- Portrait/rotated secondary monitor (transform: 1 = 90°, 3 = 270°).
-- hl.monitor({ output = "DP-2", mode = "preferred", position = "auto", scale = 1, transform = 1 })

-- Matched by monitor description (not port name), so this stays correct no
-- matter which physical DP port each monitor's cable is plugged into.

-- Main ultrawide (MSI MAG401QR), landscape, anchored left (primary).
hl.monitor({ output = "desc:Microstep MSI MAG401QR", mode = "3440x1440@60", position = "0x0", scale = 1 })

-- Secondary monitor (Dell U2211H) rotated to portrait, right of the ultrawide.
-- transform = 1 is 90° (clockwise). Switch to 3 for 270° (counter-clockwise) if it's upside down for your setup.
hl.monitor({ output = "desc:Dell Inc. DELL U2211H", mode = "1920x1080@60", position = "3440x0", scale = 1, transform = 1 })

-- golden-spiral's workspace (10, matching ~/.config/goldenspiral/bar.json's
-- "workspace" key) always shows on the main ultrawide at session start,
-- instead of landing on whatever workspace Hyprland last remembered.
hl.workspace_rule({ workspace = "10", monitor = "desc:Microstep MSI MAG401QR", default = true })

-- Workspace 1 is pinned to the main ultrawide too, so it stays that
-- monitor's normal home workspace and never gets claimed by the portrait
-- monitor below.
hl.workspace_rule({ workspace = "1", monitor = "desc:Microstep MSI MAG401QR" })

-- Portrait monitor gets its own dedicated workspace (11), out of the 1-9
-- range used for SUPER + <number> switching, so it never mixes into the
-- main monitor's numbered workspaces or needs a quick keybind of its own.
-- default = true so it's always what the portrait monitor shows at
-- session start, instead of landing on whatever Hyprland last remembered.
hl.workspace_rule({ workspace = "11", monitor = "desc:Dell Inc. DELL U2211H", default = true })
